{% extends 'base.html.twig' %}

{% block title %}Reset password{% endblock %}

{% block body %}
    <div class="w-[90%] m-auto">
        <h1 class="text-center mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Reset Password</h1>
        <img class="h-auto max-w-lg mx-auto" alt="Logo SnowTricks" src="{{ asset('build/images/snowtricks.png') }}">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="submit">Reset</button>
        {{ form_end(form) }}
        <br>

        <ul class="flex flex-wrap items-center justify-center text-gray-900 dark:text-white">
            <li>
                <a class="me-4 hover:underline md:me-6text-blue-600 hover:underline dark:text-blue-500" href="{{ path('app_login') }}">Connexion</a>
            </li>
            <li>
                <a class="me-4 hover:underline md:me-6 text-blue-600 hover:underline dark:text-blue-500" href="{{ path('app_register') }}">Inscription</a>
            </li>
        </ul>
    </div>
{% endblock %}
