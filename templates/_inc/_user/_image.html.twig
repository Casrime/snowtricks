<div class="mb-5">
    <a href="{{ path('app_image_new') }}" class="btn-blue">
        {{ 'app.images.new'|trans }}
    </a>
</div>
<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
    <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-6 py-3">
                    {{ 'app.id'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'app.name'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'app.alt'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'app.tricks.name'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'app.actions'|trans }}
                </th>
            </tr>
        </thead>
        <tbody>
            {% for image in images %}
                <tr class="odd:bg-white odd:dark:bg-gray-900 even:bg-gray-50 even:dark:bg-gray-800 border-b dark:border-gray-700 border-gray-200">
                    <td class="px-6 py-4">
                        {{ image.id }}
                    </td>
                    <td class="px-6 py-4">
                        <img class="img-thumbnail" src="{{ asset('uploads/images/' ~ image.name) }}" alt="{{ image.alt }}" width="200" height="200">
                    </td>
                    <td class="px-6 py-4">
                        {{ image.alt }}
                    </td>
                    <td class="px-6 py-4">
                        <span class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-green-400 border border-green-400">{{ image.tricks.count }}</span>
                    </td>
                    <td class="px-6 py-4">
                        <span data-modal-target="image-{{ image.id }}" data-modal-toggle="image-{{ image.id }}">
                            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/>
                            </svg>
                        </span>
                        {{ include('_inc/_modal.html.twig', {
                            id: image.id,
                            htmlName: 'image',
                            name: image.name,
                            includeForm: include('_inc/_delete_form.html.twig', {
                                action: path('app_image_delete', {id: image.id}),
                                content: 'app.delete'|trans,
                                value: csrf_token('delete' ~ image.id),
                            }),
                        }) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="px-6 py-4" colspan="5">{{ 'app.images.not.found'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
