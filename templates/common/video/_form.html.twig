{{ form_start(form) }}
    {{ form_widget(form) }}

    <div class="flex justify-between">
        <button class="btn-{% if delete is defined %}yellow{% else %}blue{% endif %}">{{ button_label|default('Save') }}</button>
        {% if delete is defined %}
            {{ include('_inc/_modal_button.html.twig', {
                btn_class: 'btn-red',
                content: 'Delete',
                id: video.id,
                htmlName: 'video',
            }) }}
        {% endif %}
    </div>
{{ form_end(form) }}

{% if delete is defined %}
    {{ include('_inc/_modal.html.twig', {
        id: video.id,
        htmlName: 'video',
        name: video.url,
        includeForm: include('_inc/_delete_form.html.twig', {
            action: path('app_video_delete', {id: video.id}),
            content: 'Delete',
            value: csrf_token('delete' ~ video.id),
        }),
    }) }}
{% endif %}
