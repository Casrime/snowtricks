<div class="mx-5">
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="flex justify-between">
            <button
                {% if delete is defined %}
                    class="btn-yellow"
                {% else %}
                    class="btn-blue"
                {% endif %}
            >{{ button_label|default('Save') }}</button>
            {% if delete is defined %}
                {{ include('_inc/_modal_button.html.twig', {
                    btn_class: 'btn-red',
                    content: 'Delete',
                    id: comment.id,
                    htmlName: 'comment',
                }) }}
            {% endif %}
        </div>
    {{ form_end(form) }}
</div>

{% if delete is defined %}
    {{ include('_inc/_modal.html.twig', {
        id: comment.id,
        htmlName: 'comment',
        name: comment.content,
        includeForm: include('_inc/_delete_form.html.twig', {
            action: path('app_comment_delete', {id: comment.id}),
            content: 'Delete',
            value: csrf_token('delete' ~ comment.id),
        }),
    }) }}
{% endif %}
